DATABASE_URL=postgresql+psycopg://attendance:attendance_dev_password@localhost:5432/smart_attendance
JWT_SECRET=replace-with-a-long-random-value
TEACHER_INVITE_CODE=SMART-TEACHER-DEMO
ADMIN_INVITE_CODE=SMART-ADMIN-DEMO
MEDIA_ROOT=storage
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Face recognition (InsightFace) ---
# Model pack (downloaded to ~/.insightface on first use). buffalo_l = most
# accurate; buffalo_s = lighter MobileFaceNet-class recognizer.
FACE_MODEL_PACK=buffalo_l
# Set true only with onnxruntime-gpu + CUDA installed.
FACE_USE_GPU=false
FACE_CTX_ID=0
# Larger detector input finds smaller/farther faces (raise for wide CCTV rooms).
FACE_DET_SIZE=1024
FACE_DET_THRESHOLD=0.5
# Cosine-similarity match threshold (raise if false matches, lower if misses).
FACE_MATCH_SIMILARITY=0.40
FACE_MAX_FRAME_WIDTH=1600
RECOGNITION_SAMPLE_INTERVAL_SECONDS=0.5
